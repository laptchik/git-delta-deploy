#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$SCRIPT_DIR/git-delta-deploy" ]]; then
  GIT_DELTA_DEPLOY="$SCRIPT_DIR/git-delta-deploy"
elif GIT_DELTA_DEPLOY="$(command -v git-delta-deploy)"; then
  :
else
  echo "ERROR: Cannot find the git-delta-deploy executable beside this launcher or on PATH." >&2
  exit 1
fi

printf 'Second-hop SSH password: ' >&2
if ! IFS= read -r -s PASSWORD; then
  printf '\nERROR: Could not read the second-hop SSH password.\n' >&2
  exit 1
fi
printf '\n' >&2

GIT_DELTA_DEPLOY_PASSWORD="$PASSWORD" exec "$GIT_DELTA_DEPLOY" "$@"
